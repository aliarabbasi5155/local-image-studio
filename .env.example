# Docker settings: compose.yaml on Linux, compose.windows.yaml on Windows.
# Copy to .env and change what you need; install.ps1 creates it automatically on Windows.

# This computer's home-network address, e.g. 192.168.1.20 (hostname -I on Linux; ipconfig on Windows).
# Setting it turns on the installable phone app (HTTPS on port 7443). Without it, phones use the website.
LIS_ADDRESS=

# Linux only: your user/group IDs (id -u / id -g), so host files belong to you.
# Windows uses fixed container IDs and named volumes instead.
LIS_UID=1000
LIS_GID=1000

# Optional downloads on the next start: the SNOFS style adapter (1.1 GB, personal-use license,
# https://huggingface.co/Ashen3/SNOFS) and photo-to-video (about 25 GB).
LIS_SNOFS=0
LIS_VIDEO=0

# Where the website listens. Use 127.0.0.1 to allow only this computer.
# The Windows installer sets this to 127.0.0.1 in a newly created .env.
LIS_BIND=0.0.0.0
LIS_PORT=7878
LIS_HTTPS_PORT=7443
