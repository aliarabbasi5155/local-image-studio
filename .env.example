# Settings for the Linux Docker setup (compose.yaml). Copy to .env and change what you need.

# This computer's address on your home network, for example 192.168.1.20 (find it with: hostname -I).
# Setting it turns on the installable phone app (HTTPS on port 7443). Without it, phones use the website.
LIS_ADDRESS=

# Your user and group IDs (id -u / id -g), so files in models/ and studio-data/ belong to you.
LIS_UID=1000
LIS_GID=1000

# Optional downloads on the next start: the SNOFS style adapter (1.1 GB, personal-use license,
# https://huggingface.co/Ashen3/SNOFS) and photo-to-video (about 25 GB).
LIS_SNOFS=0
LIS_VIDEO=0

# Where the website listens. Use 127.0.0.1 to allow only this computer.
LIS_BIND=0.0.0.0
LIS_PORT=7878
LIS_HTTPS_PORT=7443
